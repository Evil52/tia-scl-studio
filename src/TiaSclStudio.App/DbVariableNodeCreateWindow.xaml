<Window x:Class="TiaSclStudio.App.DbVariableNodeCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DB-переменная UDT"
        Width="760"
        Height="600"
        MinWidth="680"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="22,16" Background="#101720"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="ГЛОБАЛЬНАЯ DB-ПЕРЕМЕННАЯ UDT"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,5,0,0"
                           Text="Экземпляр UDT для подключения к INPUT/IN_OUT/OUTPUT блока. SCL-выражение: &quot;DB&quot;.&quot;Variable&quot;."
                           TextWrapping="Wrap" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18">
                <WrapPanel Margin="0,0,0,14">
                    <RadioButton x:Name="NewVariableRadioButton" Content="Создать описание"
                                 IsChecked="True" Margin="0,0,24,0"
                                 Foreground="{StaticResource TextBrush}"
                                 Checked="Mode_Changed" />
                    <RadioButton x:Name="ExistingVariableRadioButton" Content="Использовать существующее"
                                 Foreground="{StaticResource TextBrush}"
                                 Checked="Mode_Changed" />
                </WrapPanel>

                <Border x:Name="ExistingPanel" Visibility="Collapsed" Padding="13"
                        Background="#0C151C" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="DB-ПЕРЕМЕННАЯ" Margin="0,0,0,7"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox x:Name="ExistingVariableComboBox" MinHeight="36"
                                  Padding="9,6" SelectionChanged="Field_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas">
                                        <Run Text="{Binding DataBlockName}"/><Run Text="."/><Run Text="{Binding VariableName}"/>
                                        <Run Text="  :  "/><Run Text="{Binding DataType}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Grid x:Name="NewPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="ИМЯ ГЛОБАЛЬНОГО DB" Margin="0,0,0,7"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="DataBlockNameTextBox" Text="DB_Valve" MinHeight="36"
                                 Padding="10,7" FontFamily="Consolas"
                                 Foreground="{StaticResource TextBrush}" Background="#0C131A"
                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                 TextChanged="Field_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ИМЯ ПЕРЕМЕННОЙ" Margin="0,0,0,7"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="VariableNameTextBox" Text="Data" MinHeight="36"
                                 Padding="10,7" FontFamily="Consolas"
                                 Foreground="{StaticResource TextBrush}" Background="#0C131A"
                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                 TextChanged="Field_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="ТИП UDT" Margin="0,0,0,7"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox x:Name="DataTypeComboBox" MinHeight="36" Padding="9,6"
                                  DisplayMemberPath="Name" SelectionChanged="Field_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                        <TextBlock Text="КОММЕНТАРИЙ" Margin="0,0,0,7"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="CommentTextBox" MinHeight="36" Padding="10,7"
                                 Foreground="{StaticResource TextBrush}" Background="#0C131A"
                                 BorderBrush="{StaticResource BorderStrongBrush}" />
                    </StackPanel>
                    <CheckBox x:Name="GenerateDataBlockCheckBox" Grid.Row="3" Grid.ColumnSpan="3"
                              Margin="0,16,0,0" IsChecked="True"
                              Content="Создать этот глобальный DB при выгрузке в TIA"
                              Foreground="{StaticResource TextBrush}" Checked="Field_Changed"
                              Unchecked="Field_Changed" />
                </Grid>

                <Border Margin="0,16,0,0" Padding="13" Background="#0C151C"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="НАПРАВЛЕНИЕ НА СХЕМЕ" Margin="0,0,0,7"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox x:Name="DirectionComboBox" MinHeight="36" Padding="9,6"
                                      SelectionChanged="Field_Changed">
                                <ComboBoxItem Content="Источник — значение идёт в блок" Tag="Source" />
                                <ComboBoxItem Content="Приёмник — блок пишет значение" Tag="Sink" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                   Text="Для VAR_IN_OUT обычно выбирайте «Источник»: переменная передаётся блоку по ссылке и остаётся записываемой." />
                    </Grid>
                </Border>
                <TextBlock x:Name="ValidationText" Margin="0,14,0,0" TextWrapping="Wrap"
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="18,13" Background="#0B1218"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Отмена" MinWidth="112" Style="{StaticResource ActionButtonStyle}" IsCancel="True" />
                <Button x:Name="OkButton" Content="Добавить" MinWidth="112" Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
