<Window x:Class="TiaSclStudio.App.UdtEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактор UDT"
        Width="920"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="EditorLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0C131A" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentMutedBrush}" />
        </Style>
        <Style x:Key="GridEditingTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource EditorTextBoxStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="GridComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource DarkComboBoxStyle}">
            <Setter Property="Padding" Value="8,0,30,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,14"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="EditorTitleText"
                               Text="РЕДАКТОР ПОЛЬЗОВАТЕЛЬСКОГО ТИПА"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Поля UDT используют только базовые типы TIA или другие объявленные UDT."
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="8,4"
                        Background="#1D3028"
                        BorderBrush="#62DFA4"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock x:Name="UdtIdText"
                               FontFamily="Consolas"
                               FontSize="9"
                               Foreground="#62DFA4" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ИМЯ UDT" Style="{StaticResource EditorLabelStyle}" />
                    <TextBox x:Name="NameTextBox" Style="{StaticResource EditorTextBoxStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ВЕРСИЯ" Style="{StaticResource EditorLabelStyle}" />
                    <TextBox x:Name="VersionTextBox"
                             Style="{StaticResource EditorTextBoxStyle}"
                             Text="0.1" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,13,0,0">
                <TextBlock Text="КОММЕНТАРИЙ" Style="{StaticResource EditorLabelStyle}" />
                <TextBox x:Name="CommentTextBox"
                         Height="58"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource EditorTextBoxStyle}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="ПОЛЯ UDT"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionTitleStyle}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="＋ Добавить"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="AddMember_Click" />
                    <Button Content="Удалить"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="DeleteMember_Click" />
                    <Button Content="↑"
                            Width="42"
                            Padding="6,8"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="MoveMemberUp_Click" />
                    <Button Content="↓"
                            Width="42"
                            Padding="6,8"
                            Margin="0"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="MoveMemberDown_Click" />
                </StackPanel>
            </Grid>

            <DataGrid x:Name="MembersGrid"
                      Grid.Row="3"
                      Margin="0,8,0,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      SelectionUnit="FullRow"
                      Style="{StaticResource DarkDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME"
                                        Width="170"
                                        Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource GridEditingTextBoxStyle}" />
                    <DataGridComboBoxColumn x:Name="MemberDataTypeColumn"
                                            Header="DATA TYPE"
                                            Width="190"
                                            SelectedItemBinding="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ElementStyle="{StaticResource GridComboBoxStyle}"
                                            EditingElementStyle="{StaticResource GridComboBoxStyle}" />
                    <DataGridTextColumn Header="INITIAL VALUE"
                                        Width="150"
                                        Binding="{Binding InitialValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource GridEditingTextBoxStyle}" />
                    <DataGridTextColumn Header="COMMENT"
                                        Width="*"
                                        Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        EditingElementStyle="{StaticResource GridEditingTextBoxStyle}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,11"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="ValidationHintText"
                           VerticalAlignment="Center"
                           Text="Ссылки и циклы UDT будут проверены перед сохранением."
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Отмена"
                            MinWidth="105"
                            Style="{StaticResource ActionButtonStyle}"
                            IsCancel="True" />
                    <Button Content="ОК"
                            MinWidth="105"
                            Margin="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
