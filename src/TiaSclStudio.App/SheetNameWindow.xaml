<Window x:Class="TiaSclStudio.App.SheetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Имя листа"
        Width="480"
        Height="235"
        MinWidth="420"
        MinHeight="220"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="1"
            Padding="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Grid.Row="1"
                       Margin="0,7,0,0"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="SCL-имя: латинские буквы, цифры и подчёркивание." />
            <TextBox x:Name="NameTextBox"
                     Grid.Row="2"
                     Height="38"
                     Margin="0,13,0,0"
                     Padding="10,7"
                     FontFamily="Consolas"
                     FontSize="13"
                     Background="#0C131A"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     BorderThickness="1"
                     KeyDown="NameTextBox_KeyDown" />
            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       FontSize="10"
                       Foreground="{StaticResource ErrorBrush}" />
            <StackPanel Grid.Row="4"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="105"
                        Margin="0,0,8,0"
                        Content="Отмена"
                        IsCancel="True"
                        Style="{StaticResource ActionButtonStyle}" />
                <Button Width="105"
                        Margin="0"
                        Content="Применить"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
