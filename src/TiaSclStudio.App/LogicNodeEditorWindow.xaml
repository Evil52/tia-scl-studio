<Window x:Class="TiaSclStudio.App.LogicNodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Логический узел"
        Width="580"
        Height="380"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,15"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="ЛОГИКА / СРАВНЕНИЕ"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Операция сворачивается в выражение SCL с явными скобками."
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,20">
            <TextBlock Text="ОПЕРАЦИЯ"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <ComboBox x:Name="OperationComboBox"
                      Height="38"
                      MinWidth="260"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource DarkComboBoxStyle}"
                      SelectionChanged="OperationComboBox_SelectionChanged" />

            <TextBlock Margin="0,18,0,7"
                       Text="ТИП ОПЕРАНДОВ"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="OperandDataTypeTextBox"
                     Height="38"
                     Padding="10,7"
                     FontFamily="Consolas"
                     Foreground="{StaticResource TextBrush}"
                     Background="#0C131A"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     BorderThickness="1"
                     CaretBrush="{StaticResource AccentBrush}"
                     SelectionBrush="{StaticResource AccentMutedBrush}" />

            <TextBlock x:Name="ValidationText"
                       Margin="0,10,0,0"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="AND/OR/NOT работают с Bool; для сравнения задайте одинаковый тип обоих входов."
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="18,13"
                Background="#0B1218"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Отмена"
                        MinWidth="112"
                        Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True" />
                <Button Content="ОК"
                        MinWidth="112"
                        Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
