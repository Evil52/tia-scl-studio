<Window x:Class="TiaSclStudio.App.UdtLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека UDT"
        Width="900"
        Height="650"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,14"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="БИБЛИОТЕКА ПОЛЬЗОВАТЕЛЬСКИХ ТИПОВ"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Создание, изменение и удаление UDT применяются к проекту одной операцией Undo/Redo."
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="9,4"
                        Background="#1D3028"
                        BorderBrush="#62DFA4"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock x:Name="CountText"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="#62DFA4" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox x:Name="DataTypeList"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="DataTypeList_SelectionChanged"
                     MouseDoubleClick="DataTypeList_MouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card"
                                            Padding="13"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#62DFA4" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="#62DFA4" />
                                            <Setter TargetName="Card" Property="Background" Value="#1D3028" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,5,0,0"
                                           Text="{Binding Comment}"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <Border Padding="7,3"
                                        Background="#1D3028"
                                        BorderBrush="#62DFA4"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <TextBlock Text="UDT"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#62DFA4" />
                                </Border>
                                <TextBlock Margin="0,7,0,0"
                                           HorizontalAlignment="Right"
                                           FontFamily="Consolas"
                                           FontSize="9"
                                           Foreground="{StaticResource TextDimBrush}">
                                    <Run Text="{Binding Members.Count, Mode=OneWay, FallbackValue=0, TargetNullValue=0}" /><Run Text=" полей" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
                <Button Content="＋ Новый UDT"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewDataType_Click" />
                <Button x:Name="EditButton"
                        Content="Редактировать"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="EditDataType_Click" />
                <Button x:Name="DeleteButton"
                        Content="Удалить"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="DeleteDataType_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Padding="18,11"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           Text="Удаление используемого UDT заблокировано; переименование обновляет ссылки автоматически."
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Отмена"
                            MinWidth="105"
                            Style="{StaticResource ActionButtonStyle}"
                            IsCancel="True" />
                    <Button Content="Применить"
                            MinWidth="115"
                            Margin="0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="Apply_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
