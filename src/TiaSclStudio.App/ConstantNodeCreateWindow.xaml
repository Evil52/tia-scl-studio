<Window x:Class="TiaSclStudio.App.ConstantNodeCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая константа"
        Width="570"
        Height="330"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="20,15"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="НОВАЯ КОНСТАНТА"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Однострочный SCL-литерал; синтаксис окончательно проверит компилятор TIA."
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="ЛИТЕРАЛ SCL"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="LiteralTextBox"
                     Grid.Row="1"
                     MinHeight="36"
                     Padding="11,7"
                     FontFamily="Consolas"
                     Foreground="{StaticResource TextBrush}"
                     Background="#0C131A"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     CaretBrush="{StaticResource AccentBrush}" />
            <TextBlock Grid.Column="2"
                       Text="ТИП ДАННЫХ"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="DataTypeTextBox"
                     Grid.Row="1"
                     Grid.Column="2"
                     MinHeight="36"
                     Padding="11,7"
                     FontFamily="Consolas"
                     Foreground="{StaticResource TextBrush}"
                     Background="#0C131A"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     CaretBrush="{StaticResource AccentBrush}" />
            <TextBlock x:Name="ValidationText"
                       Grid.Row="2"
                       Grid.ColumnSpan="3"
                       Margin="0,12,0,0"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Примеры: TRUE : Bool, T#3s : Time, 27648 : Int. Переводы строк и операторы завершения запрещены."
                       TextWrapping="Wrap" />
        </Grid>
        <Border Grid.Row="2"
                Padding="18,13"
                Background="#0B1218"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Отмена"
                        MinWidth="112"
                        Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True" />
                <Button Content="Добавить"
                        MinWidth="112"
                        Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
