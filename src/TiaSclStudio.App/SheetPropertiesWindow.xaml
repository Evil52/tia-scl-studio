<Window x:Class="TiaSclStudio.App.SheetPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свойства листа"
        Width="620"
        Height="390"
        MinWidth="520"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,15"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="СВОЙСТВА ЛИСТА"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Имя определяет SCL-блок листа, размеры — доступное полотно схемы."
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="ИМЯ ЛИСТА"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="NameTextBox"
                     Grid.Row="1"
                     MinHeight="38"
                     Padding="10,7"
                     FontFamily="Consolas"
                     FontSize="13"
                     Foreground="{StaticResource TextBrush}"
                     Background="#0C131A"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     BorderThickness="1"
                     CaretBrush="{StaticResource AccentBrush}"
                     SelectionBrush="{StaticResource AccentMutedBrush}" />

            <TextBlock Grid.Row="3"
                       Text="РАЗМЕР ПОЛОТНА"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ШИРИНА"
                               Margin="0,0,0,5"
                               FontSize="9"
                               Foreground="{StaticResource TextDimBrush}" />
                    <TextBox x:Name="WidthTextBox"
                             MinHeight="38"
                             Padding="10,7"
                             FontFamily="Consolas"
                             FontSize="13"
                             Foreground="{StaticResource TextBrush}"
                             Background="#0C131A"
                             BorderBrush="{StaticResource BorderStrongBrush}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource AccentBrush}"
                             SelectionBrush="{StaticResource AccentMutedBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ВЫСОТА"
                               Margin="0,0,0,5"
                               FontSize="9"
                               Foreground="{StaticResource TextDimBrush}" />
                    <TextBox x:Name="HeightTextBox"
                             MinHeight="38"
                             Padding="10,7"
                             FontFamily="Consolas"
                             FontSize="13"
                             Foreground="{StaticResource TextBrush}"
                             Background="#0C131A"
                             BorderBrush="{StaticResource BorderStrongBrush}"
                             BorderThickness="1"
                             CaretBrush="{StaticResource AccentBrush}"
                             SelectionBrush="{StaticResource AccentMutedBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ValidationText"
                       Grid.Row="5"
                       Margin="0,10,0,0"
                       Text="Размеры должны быть конечными положительными числами."
                       TextWrapping="Wrap"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}" />
        </Grid>

        <Border Grid.Row="2"
                Padding="18,13"
                Background="#0B1218"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Отмена"
                        MinWidth="112"
                        Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True" />
                <Button Content="Применить"
                        MinWidth="112"
                        Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Apply_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
