<Window x:Class="TiaSclStudio.App.NoteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметка на схеме"
        Width="620"
        Height="430"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,15"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="ЗАМЕТКА НА ЛИСТЕ"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,4,0,0"
                           Text="Текст отображается на схеме и добавляется в SCL как комментарий."
                           FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="ТЕКСТ"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}" />
            <TextBox x:Name="NoteTextBox"
                     Grid.Row="1"
                     Padding="12,10"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Foreground="{StaticResource TextBrush}"
                     Background="#0C131A"
                     BorderBrush="{StaticResource BorderStrongBrush}"
                     BorderThickness="1"
                     CaretBrush="{StaticResource AccentBrush}"
                     SelectionBrush="{StaticResource AccentMutedBrush}" />
            <TextBlock x:Name="ValidationText"
                       Grid.Row="2"
                       Margin="0,9,0,0"
                       FontSize="10"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="До 2000 символов; управляющие XML-символы запрещены."
                       TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2"
                Padding="18,13"
                Background="#0B1218"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Отмена"
                        MinWidth="112"
                        Style="{StaticResource ActionButtonStyle}"
                        IsCancel="True" />
                <Button Content="ОК"
                        MinWidth="112"
                        Margin="0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
