<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared build settings for every project in the repository.

  Imported by Microsoft.Common.props, so every project must import
  Microsoft.Common.props explicitly at the top of its file for these
  values to land before the project's own PropertyGroups.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <ProductVersion>0.3.1</ProductVersion>

    <!-- Reproducible output: same source in, same bytes out. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition=" '$(CI)' == 'true' ">true</ContinuousIntegrationBuild>

    <!-- A warning that reaches a release build is a defect that shipped. -->
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors Condition=" '$(TreatWarningsAsErrors)' == '' ">true</TreatWarningsAsErrors>

    <!--
      CS1591 (missing XML comment) is not enabled: the codebase documents
      intent rather than every member, and turning it on would create
      thousands of low-value diagnostics that hide the real ones.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- SonarQube/SonarCloud and CodeQL both consume the generated XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
